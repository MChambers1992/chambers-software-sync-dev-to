{
    "name": "mchambers1992/chambers-software-sync-dev-to",
    "description": "WordPress plugin: auto cross-post to Dev.to",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Michael Chambers"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcsstandards/phpcsutils": "^1.0",
        "phpcsstandards/phpcsextra": "^1.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.10",
        "php-stubs/wordpress-stubs": "^6.5",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload-dev": {
        "psr-4": {
            "CrossPostDevTo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test":            "phpunit --configuration phpunit.xml.dist",
        "test:unit":       "phpunit --configuration phpunit.xml.dist --testsuite unit",
        "test:integration":"phpunit --configuration phpunit.xml.dist --testsuite integration",
        "test:coverage":   "phpunit --configuration phpunit.xml.dist --coverage-html coverage/",
        "phpcs":           "phpcs",
        "phpcbf":          "phpcbf",
        "analyse":         "phpstan analyse --configuration phpstan.neon.dist --memory-limit=2G --no-progress --debug",
        "check":           [ "@phpcs", "@analyse", "@test:unit" ],
        "build:zip":       "php bin/build-zip.php",
        "post-install-cmd": "git config core.hooksPath .githooks || true",
        "post-update-cmd":  "git config core.hooksPath .githooks || true"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
