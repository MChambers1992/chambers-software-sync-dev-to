<?xml version="1.0"?>
<ruleset name="Chambers Software Sync for Dev.to">
    <description>Coding standards for the Chambers Software Sync for Dev.to plugin.</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/coverage/*</exclude-pattern>
    <exclude-pattern>/.phpstan/*</exclude-pattern>
    <exclude-pattern>/bin/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress">
        <!-- Short array syntax is used throughout and is intentional.
             WPCS 3.x pulls this rule from two different sniff namespaces —
             both need excluding, not just one. -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <!-- Plugin uses typed properties/return types (PHP 7.4+ baseline). -->
        <exclude name="Squiz.Commenting"/>
        <!-- 4-space indentation is used consistently throughout, not WP
             core's tabs convention. Reformatting the whole codebase to tabs
             now would be a large, purely mechanical, high-risk diff for no
             functional benefit — this project intentionally isn't matching
             WP core's raw indentation style, same as most modern plugins. -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <!-- Yoda conditions are WP core's own legacy style choice; PHPStan
             (level 5, run separately) already catches accidental
             assignment-in-condition bugs, which is what Yoda conditions
             exist to prevent. Not enforcing this stylistic-only rule. -->
        <exclude name="WordPress.PHP.YodaConditions"/>
        <!-- Our file naming (class-publisher.php, not
             class-cross-post-devto-publisher.php) is the plugin's established,
             documented convention (see CLAUDE.md's architecture table) —
             not a violation to fix, a style already chosen deliberately. -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <!-- Exact `=>`/`=` column alignment across multi-line statements is
             high-churn (any edit that changes one key's length invalidates
             alignment on every other line in the block) for no readability
             gain over consistent single-space alignment. -->
        <exclude name="Generic.Formatting.MultipleStatementAlignment"/>
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
        <!-- These four formatting sniffs disagree with each other on how to
             reformat the same multi-line function calls/arrays (one wants
             tabs, another wants every item on its own line, another wants a
             specific bracket placement) — running phpcbf with them active
             produced inconsistent mixed tab/space indentation across files
             that were previously uniform. Excluding them keeps calls like
             `new WP_Error( 'code', $msg, [ 'status' => $code ] )` and short
             inline arrays exactly as written, which is how this codebase is
             consistently formatted throughout. -->
        <exclude name="PEAR.Functions.FunctionCallSignature"/>
        <exclude name="Generic.Functions.FunctionCallArgumentSpacing"/>
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
        <exclude name="WordPress.Arrays.ArrayIndentation"/>
        <exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
        <exclude name="NormalizedArrays.Arrays.CommaAfterLast"/>
        <!-- Templated PHP/HTML files (metabox, settings, bulk-sync pages)
             intentionally use compact inline `<?php ... ?>` tags, which is
             the standard WordPress admin-page template pattern. -->
        <exclude name="Squiz.PHP.EmbeddedPhp"/>
        <!-- `$x ?: $y` is a deliberate, well-understood PHP idiom here
             (e.g. `$retry_after ?: null`), not the "rarely used correctly"
             case this sniff guards against. -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="chambers-software-sync-dev-to"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="cross_post_devto"/>
                <element value="Cross_Post_DevTo"/>
                <element value="CROSS_POST_DEVTO"/>
            </property>
        </properties>
    </rule>
</ruleset>
