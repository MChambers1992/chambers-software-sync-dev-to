parameters:
    level: 5
    paths:
        - includes
        - cross-post-devto.php
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - .phpstan/constants.php
    # Each parallel worker independently loads the full WordPress stubs
    # (thousands of declarations) into its own process, which was crashing
    # workers even at a 512M per-process memory limit. This is a 6-file
    # codebase — analysing it single-process is plenty fast and avoids the
    # crash entirely rather than chasing a bigger memory ceiling.
    parallel:
        maximumNumberOfProcesses: 1

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
