{
  "branches": [
    "main"
  ],
  "repositoryUrl": "https://github.com/MChambers1992/cross-post-devto.git",
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "parserOpts": {
          "headerPattern": "^\\[(\\w+)\\]\\s+(.*)$",
          "headerCorrespondence": [ "type", "subject" ],
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING"
          ]
        },
        "releaseRules": [
          { "type": "Major", "release": "major" },
          { "type": "Minor", "release": "minor" },
          { "type": "Patch", "release": "patch" },
          { "type": "BREAKING", "release": "major" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular",
        "parserOpts": {
          "headerPattern": "^\\[(\\w+)\\]\\s+(.*)$",
          "headerCorrespondence": [ "type", "subject" ],
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING"
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i \"s/Version: *[0-9.]*$/Version:     ${nextRelease.version}/\" chambers-software-sync-dev-to.php && sed -i \"s/CROSS_POST_DEVTO_VERSION', '[^']*'/CROSS_POST_DEVTO_VERSION', '${nextRelease.version}'/\" chambers-software-sync-dev-to.php"
      }
    ],
    [
      "@semantic-release/git",
      {
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}",
        "assets": [
          "chambers-software-sync-dev-to.php",
          "CHANGELOG.md",
          "readme.txt"
        ]
      }
    ],
    [
      "@semantic-release/github",
      {
        "releasedLabels": [
          "released"
        ]
      }
    ]
  ]
}
