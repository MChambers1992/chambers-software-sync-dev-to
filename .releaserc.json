{
  "branches": [
    "main"
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          {
            "message": "/\\[Major\\]/",
            "release": "major"
          },
          {
            "message": "/\\[Minor\\]/",
            "release": "minor"
          },
          {
            "message": "/\\[Patch\\]/",
            "release": "patch"
          },
          {
            "message": "/\\[BREAKING\\]/",
            "release": "major"
          }
        ],
        "parserOpts": {
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING"
          ]
        }
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular",
        "parserOpts": {
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING"
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i \"s/Version: *[0-9.]*$/Version:     ${nextRelease.version}/\" cross-post-devto.php && sed -i \"s/CROSS_POST_DEVTO_VERSION', '[^']*'/CROSS_POST_DEVTO_VERSION', '${nextRelease.version}'/\" cross-post-devto.php"
      }
    ],
    [
      "@semantic-release/git",
      {
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}",
        "assets": [
          "cross-post-devto.php",
          "CHANGELOG.md",
          "readme.txt"
        ]
      }
    ],
    [
      "@semantic-release/github",
      {
        "releasedLabels": [
          "released"
        ]
      }
    ]
  ]
}
